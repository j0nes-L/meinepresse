---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'product';
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, image = '/apple-touch-icon.png', type = 'website', jsonLd = [], noindex = false } = Astro.props;
// Saubere URLs ohne .html und ohne Slash am Ende (passend zu cleanUrls in vercel.json)
const cleanPath = Astro.url.pathname.replace(/(index)?\.html$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(cleanPath, Astro.site);
const ogImage = new URL(image, Astro.site);

const siteLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${Astro.site}#organization`,
      name: 'MeinePRESSe',
      url: Astro.site?.toString(),
      logo: new URL('/favicon.svg', Astro.site).toString(),
    },
    {
      '@type': 'WebSite',
      '@id': `${Astro.site}#website`,
      name: 'MeinePRESSe',
      url: Astro.site?.toString(),
      inLanguage: 'de-DE',
      publisher: { '@id': `${Astro.site}#organization` },
    },
  ],
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="preload" href="/fonts/instrument-sans-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#FBF7F1" />

    <meta property="og:site_name" content="MeinePRESSe" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:type" content={type === 'product' ? 'product' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />

    <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />
    {jsonLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
