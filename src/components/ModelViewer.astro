---
export interface ViewerItem {
  label: string;
  src: string;
  alt: string;
  orbit?: string;
}

interface Props {
  items: ViewerItem[];
  class?: string;
  id?: string;
}

const { items, class: className, id } = Astro.props;
---

<figure class:list={['viewer', className]} id={id} data-viewer={JSON.stringify(items)} data-state="loading">
  <div class="viewer-stage">
    <div class="viewer-loader" role="progressbar" aria-label="3D-Modell wird geladen" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
      <svg viewBox="0 0 48 48" aria-hidden="true">
        <circle class="viewer-ring-track" cx="24" cy="24" r="20" pathLength="100" />
        <circle class="viewer-ring-arc" cx="24" cy="24" r="20" pathLength="100" />
      </svg>
    </div>
    <div class="viewer-overlay">
      <p class="viewer-msg" role="status"></p>
      <button class="btn btn-light viewer-start" type="button" data-viewer-start>
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M12 2 3 7v10l9 5 9-5V7l-9-5Z"/><path d="m3 7 9 5 9-5M12 12v10"/></svg>
        <span class="viewer-start-label">In 3D ansehen</span>
      </button>
    </div>
  </div>

  {items.length > 1 && (
    <div class="viewer-bar">
      <div class="viewer-tabs" role="group" aria-label="Modell wählen">
        {items.map((it, i) => (
          <button type="button" data-viewer-tab={i} aria-pressed={i === 0 ? 'true' : 'false'}>{it.label}</button>
        ))}
      </div>
    </div>
  )}
  <figcaption class="viewer-hint">Ziehen zum Drehen · Strg/⌘ + Scrollen zum Zoomen</figcaption>
</figure>

<script>
  import { initViewers } from '../scripts/viewer';
  initViewers();
</script>
