---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

export interface ViewerItem {
  label: string;
  src: string;
  alt: string;
  image: ImageMetadata;
  imageAlt: string;
  orbit?: string;
}

interface Props {
  items: ViewerItem[];
  autoload?: boolean;
  priority?: boolean;
  sizes?: string;
  class?: string;
  id?: string;
}

const { items, autoload = false, priority = false, sizes = '(min-width: 960px) 50vw, 100vw', class: className, id } = Astro.props;

const models = items.map(({ label, src, alt, orbit }) => ({ label, src, alt, orbit }));
---

<figure class:list={['viewer', className]} id={id} data-viewer={JSON.stringify(models)} data-autoload={autoload ? '' : undefined}>
  <div class="viewer-stage">
    {items.map((it, i) => (
      <Picture
        src={it.image}
        alt={it.imageAlt}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[480, 768, 1024]}
        sizes={sizes}
        class="viewer-poster"
        data-index={i}
        hidden={i > 0}
        loading={priority && i === 0 ? 'eager' : 'lazy'}
        fetchpriority={priority && i === 0 ? 'high' : 'auto'}
      />
    ))}
    <span class="viewer-spinner" aria-hidden="true"></span>
  </div>

  <div class="viewer-bar">
    {items.length > 1 && (
      <div class="viewer-tabs" role="group" aria-label="Modell wählen">
        {items.map((it, i) => (
          <button type="button" data-viewer-tab={i} aria-pressed={i === 0 ? 'true' : 'false'}>{it.label}</button>
        ))}
      </div>
    )}
    <button class="btn btn-light viewer-start" type="button" data-viewer-start>
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M12 2 3 7v10l9 5 9-5V7l-9-5Z"/><path d="m3 7 9 5 9-5M12 12v10"/></svg>
      <span>In 3D ansehen</span>
    </button>
  </div>
  <p class="viewer-error" role="status">3D-Modell konnte nicht geladen werden.</p>
  <figcaption class="viewer-hint">Ziehen zum Drehen · Strg/⌘ + Scrollen zum Zoomen</figcaption>
</figure>

<script>
  import { initViewers } from '../scripts/viewer';
  initViewers();
</script>
