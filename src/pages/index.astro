---
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import ModelViewer from '../components/ModelViewer.astro';
import { products, comparison, faqs, formatPrice } from '../data/products';
import heroImg from '../assets/images/hero-kueche.png';

const og = await getImage({ src: heroImg, format: 'jpg', width: 1024 });

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Saftpressen von MeinePRESSe',
    itemListElement: products.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/pressen/${p.slug}`, Astro.site).toString(),
      name: p.name,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base
  title="MeinePRESSe – Saftpressen für frischen Saft | Standard, Rustic & Pro"
  description="Saftpressen von MeinePRESSe: Hebel-Zitruspresse aus Edelstahl, Gusseisen-Presse und elektrischer Slow Juicer. Alle Modelle in 3D ansehen – versandkostenfrei, 30 Tage Rückgabe."
  image={og.src}
  jsonLd={jsonLd}
>
  <section class="hero">
    <Picture
      src={heroImg}
      alt="PRESS Standard in einer hellen Küche: Eine Hand drückt den Hebel, frischer Orangensaft läuft in die Karaffe"
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[640, 1024]}
      sizes="100vw"
      class="hero-img"
      loading="eager"
      fetchpriority="high"
    />
    <div class="container hero-copy">
      <p class="eyebrow eyebrow-light">Saftpressen · manuell & elektrisch</p>
      <h1>Frischer Saft.<br />Ganz ohne Kompromisse.</h1>
      <p class="lead">
        Drei Pressen, ein Anspruch: mehr Saft, weniger Aufwand und Geräte, die viele Jahre halten.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="#modelle">Modelle entdecken</a>
        <a class="btn btn-outline-light" href="#showroom">In 3D ansehen</a>
      </div>
    </div>
  </section>

  <section class="usp" aria-label="Vorteile">
    <ul class="container usp-list">
      <li><strong>Versandkostenfrei</strong><span>Lieferung in 1–3 Werktagen</span></li>
      <li><strong>30 Tage testen</strong><span>Kostenlose Rücksendung</span></li>
      <li><strong>Bis 10 Jahre Garantie</strong><span>Ersatzteile direkt vom Hersteller</span></li>
    </ul>
  </section>

  <section id="modelle" class="section container">
    <header class="section-head">
      <h2>Unsere Saftpressen</h2>
      <p class="muted">Vom klassischen Hebel bis zur leisen Kaltpresse – finde die Presse, die zu deiner Küche passt.</p>
    </header>
    <div class="grid-3">
      {products.map((p) => <ProductCard product={p} />)}
    </div>
  </section>

  <section id="showroom" class="section section-tint">
    <div class="container showroom">
      <header class="section-head">
        <h2>Der 3D-Showroom</h2>
        <p class="muted">Dreh, zoom und vergleiche alle drei Pressen – oder stell sie per AR direkt auf deine Arbeitsplatte.</p>
      </header>
      <ModelViewer
        autoload
        sizes="(min-width: 1200px) 620px, 70vw"
        items={products.map((p) => ({
          label: p.shortName,
          src: p.model,
          alt: `${p.name} – 3D-Modell`,
          render: p.render,
          orbit: p.orbit,
        }))}
      />
    </div>
  </section>

  <section id="vergleich" class="section container">
    <header class="section-head">
      <h2>Modelle im Vergleich</h2>
      <p class="muted">Die wichtigsten Unterschiede auf einen Blick.</p>
    </header>
    <div class="table-wrap" tabindex="0" role="region" aria-label="Vergleichstabelle der Saftpressen">
      <table class="compare">
        <thead>
          <tr>
            <td></td>
            {products.map((p) => <th scope="col"><a href={`/pressen/${p.slug}`}>{p.name}</a></th>)}
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Preis</th>
            {products.map((p) => <td class="price">{formatPrice(p.price)}</td>)}
          </tr>
          {comparison.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              {products.map((p) => <td>{row.values[p.slug]}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section id="faq" class="section container narrow">
    <header class="section-head">
      <h2>Häufige Fragen</h2>
    </header>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>
</Base>
