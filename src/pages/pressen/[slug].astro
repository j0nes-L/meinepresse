---
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ModelViewer from '../../components/ModelViewer.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products, formatPrice, type Product } from '../../data/products';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product: p } = Astro.props as { product: Product };
const others = products.filter((o) => o.slug !== p.slug);
const url = new URL(`/pressen/${p.slug}`, Astro.site).toString();
const ogImage = await getImage({ src: p.image, format: 'jpg', width: 1024 });
const imageUrl = new URL(ogImage.src, Astro.site).toString();
const priceValidUntil = `${new Date().getFullYear() + 1}-12-31`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    '@id': `${url}#product`,
    name: p.name,
    sku: p.sku,
    category: p.category,
    description: p.summary,
    image: [imageUrl],
    brand: { '@type': 'Brand', name: 'MeinePRESSe' },
    additionalProperty: p.specs.map((s) => ({ '@type': 'PropertyValue', name: s.label, value: s.value })),
    subjectOf: {
      '@type': '3DModel',
      name: `${p.name} – 3D-Modell`,
      encodingFormat: 'model/gltf-binary',
      contentUrl: new URL(p.model, Astro.site).toString(),
    },
    offers: {
      '@type': 'Offer',
      url,
      price: p.price.toFixed(2),
      priceCurrency: 'EUR',
      priceValidUntil,
      availability: 'https://schema.org/InStock',
      itemCondition: 'https://schema.org/NewCondition',
      seller: { '@id': `${Astro.site}#organization` },
      shippingDetails: {
        '@type': 'OfferShippingDetails',
        shippingRate: { '@type': 'MonetaryAmount', value: '0', currency: 'EUR' },
        shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'DE' },
        deliveryTime: {
          '@type': 'ShippingDeliveryTime',
          handlingTime: { '@type': 'QuantitativeValue', minValue: 0, maxValue: 1, unitCode: 'DAY' },
          transitTime: { '@type': 'QuantitativeValue', minValue: 1, maxValue: 3, unitCode: 'DAY' },
        },
      },
      hasMerchantReturnPolicy: {
        '@type': 'MerchantReturnPolicy',
        applicableCountry: 'DE',
        returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
        merchantReturnDays: 30,
        returnMethod: 'https://schema.org/ReturnByMail',
        returnFees: 'https://schema.org/FreeReturn',
      },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Startseite', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Saftpressen', item: new URL('/#modelle', Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: p.name, item: url },
    ],
  },
];
---

<Base title={p.metaTitle} description={p.metaDescription} image={ogImage.src} type="product" jsonLd={jsonLd}>
  <div class="container">
    <nav class="breadcrumb" aria-label="Brotkrumen">
      <ol>
        <li><a href="/">Startseite</a></li>
        <li><a href="/#modelle">Saftpressen</a></li>
        <li aria-current="page">{p.name}</li>
      </ol>
    </nav>

    <section class="product">
      <ModelViewer
        id="ansehen"
        class="product-viewer"
        items={[{ label: p.shortName, src: p.model, alt: `${p.name} – 3D-Modell`, orbit: p.orbit }]}
      />

      <div class="product-info">
        <p class="eyebrow">{p.category}</p>
        <h1>{p.name}</h1>
        <p class="lead">{p.tagline}</p>
        <p class="product-price">
          {p.compareAt && <s class="price-old">{formatPrice(p.compareAt)}</s>}
          <span class="price">{formatPrice(p.price)}</span>
          <span class="muted small">inkl. MwSt., versandkostenfrei</span>
        </p>
        <p>{p.summary}</p>
        <div class="actions">
          <a class="btn btn-primary" href={`mailto:bestellung@meinepresse.de?subject=${encodeURIComponent(`Bestellung ${p.name} (${p.sku})`)}`}>
            Jetzt bestellen
          </a>
          <a class="btn btn-ghost" href="#technische-daten">Technische Daten</a>
        </div>
        <ul class="ticks">
          <li>Auf Lager – Lieferung in 1–3 Werktagen</li>
          <li>30 Tage kostenlos testen</li>
          <li>Garantie: {p.specs.find((s) => s.label === 'Garantie')?.value}</li>
        </ul>
      </div>
    </section>

    <section class="section split">
      <div>
        <h2>Darum die {p.name}</h2>
        {p.description.map((d) => <p>{d}</p>)}
      </div>
      <ul class="highlights">
        {p.highlights.map((h) => (
          <li>
            <h3>{h.title}</h3>
            <p class="muted">{h.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="technische-daten" class="section split">
      <div>
        <h2>Technische Daten</h2>
        <h3 class="subhead">Lieferumfang</h3>
        <ul class="plain">{p.inBox.map((i) => <li>{i}</li>)}</ul>
      </div>
      <dl class="specs">
        {p.specs.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="section">
      <header class="section-head">
        <h2>Weitere Modelle</h2>
      </header>
      <div class="grid-2">
        {others.map((o) => <ProductCard product={o} />)}
      </div>
    </section>
  </div>
</Base>
